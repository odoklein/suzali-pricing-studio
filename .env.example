# Supabase Configuration
VITE_SUPABASE_URL=https://[YOUR-PROJECT-ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-PUBLISHABLE-OR-ANON-KEY]

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# scripts/test-api.mjs: an owner or admin account (password already changed)
TEST_EMAIL=
TEST_PASSWORD=

# Netlify Function netlify/functions/request-reset.mjs (mot de passe oublié) : à définir dans Netlify
RESEND_API_KEY=
MAIL_FROM="Roeum Mak <no-reply@your-verified-domain.tld>"
# SITE_URL=https://pricing.suzali-conseil.com   (facultatif : sinon l'URL principale Netlify)
